
#include <stdio.h>

int main() {
    int n, bucket = 0, size, rate, packet;

    printf("Enter bucket size: ");
    scanf("%d", &size);

    printf("Enter output rate: ");
    scanf("%d", &rate);

    printf("Enter number of packets: ");
    scanf("%d", &n);

    for(int i = 1; i <= n; i++) {
        printf("Enter packet size: ");
        scanf("%d", &packet);

        if(bucket + packet <= size) {
            bucket += packet;
            printf("Packet accepted\n");
        } else {
            printf("Packet dropped\n");
        }

        if(bucket >= rate)
            bucket -= rate;
        else
            bucket = 0;

        printf("Remaining: %d\n", bucket);
    }

    return 0;
}
