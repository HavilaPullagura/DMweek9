
#include <stdio.h>
#include <math.h>

int main() {
    int x[4], y[4], i, j;
    float d;

    printf("Enter 4 instances (two attributes):\n");
    for(i = 0; i < 4; i++)
        scanf("%d%d", &x[i], &y[i]);

    printf("Dissimilarity Matrix:\n");

    for(i = 0; i < 4; i++) {
        for(j = 0; j < 4; j++) {
            d = sqrt(pow(x[i]-x[j],2) +
                     pow(y[i]-y[j],2));
            printf("%.2f ", d);
        }
        printf("\n");
    }
    return 0;
}
